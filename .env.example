# Copy to .env.local. Every value is optional: TRACE runs without any of them.
# Never commit .env.local, and never paste a key into a chat or the prompt log.

# Enables live AI drafting (server-side only). Free key: Google AI Studio.
# Free-tier content may be used by Google to improve its products and may be read
# by human reviewers, so TRACE sends only the research question and the approved
# public abstracts or passages.
GEMINI_API_KEY=

# Optional override of the model used for drafting.
GEMINI_MODEL=

# Optional contact email for Crossref's faster "polite pool". Sent to Crossref with each request.
CROSSREF_MAILTO=

# Optional. Raises the OpenAlex daily budget; DOI lookups work without it.
OPENALEX_API_KEY=
